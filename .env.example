# Required
GROQ_API_KEY=your_groq_key_here

# Models
# Any Groq-hosted JSON-mode chat model can be used.
ENHANCE_MODEL=llama-3.3-70b-versatile
REFINE_MODEL=llama-3.3-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile

# Application
APP_ENV=development
PORT=8000
# Set to true only while verifying a deployment, then remove or set false.
ENABLE_REMOTE_TEST_RUNNER=false

# Storage
# Current implementation supports local JSON storage only.
# On Lightsail, point this at a persistent directory or Docker volume.
STORAGE_BACKEND=local
STORAGE_PATH=storage/data

# MCP client defaults
VELOCITY_USER_ID=your-username-here
VELOCITY_API_URL=http://localhost:8000

# CoThinker web search (optional)
# Enables real-time Google Search inside CoThinker conversations.
# Free key at https://serper.dev
# SERPER_API_KEY=
