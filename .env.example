# ── Required ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here

# ── Models ────────────────────────────────────────────────────────
# Any Groq-hosted model works. llama-3.3-70b-versatile is the recommended default.
ENHANCE_MODEL=llama-3.3-70b-versatile
REFINE_MODEL=llama-3.3-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile

# ── Application ───────────────────────────────────────────────────
APP_ENV=development
API_SECRET=change-me-in-production

# ── Storage ───────────────────────────────────────────────────────
# Options: local | s3 | lightsail
STORAGE_BACKEND=local
# Relative or absolute path for local JSON storage (created automatically).
# In Docker, set to /data and mount a volume there.
STORAGE_PATH=storage/data

# S3 backend (set STORAGE_BACKEND=s3 to activate)
# S3_BUCKET=your-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# LightSail object storage (set STORAGE_BACKEND=lightsail to activate)
# LIGHTSAIL_BUCKET=your-bucket
# LIGHTSAIL_ENDPOINT=https://storage.ap-south-1.amazonaws.com
# LIGHTSAIL_ACCESS_KEY=
# LIGHTSAIL_SECRET_KEY=

# ── MCP client ────────────────────────────────────────────────────
VELOCITY_USER_ID=your-username-here
VELOCITY_API_URL=http://localhost:8000

# ── CoThinker — web search (optional) ────────────────────────────
# Enables real-time Google Search inside CoThinker conversations.
# Free key (2500 queries/month) at https://serper.dev
# If not set, CoThinker works normally without search.
# SERPER_API_KEY=
