# Required
GROQ_API_KEY=your_groq_key_here
OPENAI_API_KEY=sk-...  # fallback LLM provider (optional, used when Groq is unavailable)

# Models
# Any Groq-hosted JSON-mode chat model can be used.
ENHANCE_MODEL=llama-3.3-70b-versatile
REFINE_MODEL=llama-3.3-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile

# Application
APP_ENV=development
PORT=8000
# Set to true only while verifying a deployment, then remove or set false.
ENABLE_REMOTE_TEST_RUNNER=false

# Internal admin panel
# Required only for first admin bootstrap. Remove or rotate after the first login.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-temporary-password
# Local-mode admin users, sessions, managed content, and audit logs.
ADMIN_STORAGE_PATH=storage/admin

# Storage
# Current implementation supports local JSON storage only.
# On Lightsail, point this at a persistent directory or Docker volume.
STORAGE_BACKEND=local
STORAGE_PATH=storage/data

# MCP client defaults
VELOCITY_USER_ID=your-username-here
VELOCITY_API_URL=http://localhost:8000

# Serper web search (optional)
# Enables real-time Google Search inside CoThinker conversations and blog generation.
# Free key at https://serper.dev
# SERPER_API_KEY=

# Auto blog generator (disabled by default)
BLOG_AUTOGEN_ENABLED=false
BLOG_AUTOGEN_INTERVAL_HOURS=24
BLOG_AUTOGEN_RUN_ON_START=false
BLOG_AUTOGEN_MAX_POSTS_PER_RUN=1
BLOG_AUTOGEN_REGION=in
BLOG_AUTOGEN_LANGUAGE=en
BLOG_AUTOGEN_QUERIES=latest AI model updates,developer tools news,software updates today,AI productivity tools news,startup technology news,cybersecurity updates,automation tools AI
BLOG_STORAGE_PATH=storage/blog
