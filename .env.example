GROQ_API_KEY=your_groq_key_here
LLM_MODEL=llama-3.3-70b-versatile
APP_ENV=development
API_SECRET=thinkvelo-dev-secret-2026
STORAGE_PATH=storage/data

# Container/AWS deployment:
# Set STORAGE_PATH=/data when running with Docker and mount durable storage there.
# ECS Fargate: mount EFS at /data for JSON-file persistence.
# App Runner: /data is suitable only for ephemeral demo storage unless storage moves to S3/Postgres.

# MCP client config - set these when connecting from a remote machine
VELOCITY_USER_ID=your-username-here
VELOCITY_API_URL=http://localhost:8000
