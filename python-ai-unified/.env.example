# =============================================================================
# ThinkVelocity AI Unified — environment template
# Copy to .env and fill in. Secrets use REPLACE_WITH_SM_KEY_* placeholders —
# real values come from AWS Secrets Manager (see shared/settings.py loader).
# NEVER commit real secrets. Superset of docs/python-ai-merge-plan.md §3.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────
APP_PORT=8005
DEV_MODE=false
ALLOWED_ORIGINS=*

# ── LLM — Groq (shared key pool; rotation in shared/groq_client.py) ─────────
GROQ_API_KEY=REPLACE_WITH_SM_KEY_GROQ_API_KEY
CHATGROQ_API_KEY_1=REPLACE_WITH_SM_KEY_CHATGROQ_API_KEY_1
CHATGROQ_API_KEY_2=REPLACE_WITH_SM_KEY_CHATGROQ_API_KEY_2
CHATGROQ_API_KEY_3=REPLACE_WITH_SM_KEY_CHATGROQ_API_KEY_3
GROQ_REQUESTS_PER_KEY=5
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30

# ── Other LLM providers ─────────────────────────────────────────────────────
OPENAI_API_KEY=REPLACE_WITH_SM_KEY_OPENAI_API_KEY
GEMINI_API_KEY=REPLACE_WITH_SM_KEY_GEMINI_API_KEY
GOOGLE_API_KEY=REPLACE_WITH_SM_KEY_GOOGLE_API_KEY

# ── Database — PostgreSQL (/ai/* routes; pgvector RAG) ──────────────────────
# Form: postgresql+psycopg://user:pass@host:5432/localpgvelocity
PG_CONNECTION=REPLACE_WITH_SM_KEY_PG_CONNECTION

# ── Embeddings — NVIDIA API primary, local HF fallback ──────────────────────
NVIDIA_API_KEY=REPLACE_WITH_SM_KEY_NVIDIA_API_KEY
NVIDIA_EMBEDDING_API_KEY=REPLACE_WITH_SM_KEY_NVIDIA_EMBEDDING_API_KEY
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSION=1024
RELEVANCE_THRESHOLD=0.30

# ── Web search — Tavily primary, Google CSE / SerpAPI fallback ──────────────
TAVILY_API_KEY=REPLACE_WITH_SM_KEY_TAVILY_API_KEY
TAVILY_TIMEOUT_MS=10000
TAVILY_MAX_RESULTS=5
TAVILY_ENABLE_CACHING=true
TAVILY_CACHE_TTL_SECONDS=3600
TAVILY_RATE_LIMIT_PER_MINUTE=60
TAVILY_ENABLE_FALLBACK=true
TAVILY_FALLBACK_TIMEOUT_MS=8000
SERPAPI_API_KEY=REPLACE_WITH_SM_KEY_SERPAPI_API_KEY
GOOGLE_CSE_ID=REPLACE_WITH_SM_KEY_GOOGLE_CSE_ID

# ── Cache / rate limiting — Redis (/ai/* routes only) ───────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMITING_ENABLED=true

# ── Node.js backend (/context/* routes proxy persistence here) ──────────────
NODE_BACKEND_URL=http://nodejs-pg-backend-container-dev:3006

# ── Enterprise backend (/ai/prompt/find) ────────────────────────────────────
ENTERPRISE_BACKEND_BASE_URL=
ENTERPRISE_POLICY_ENDPOINT=
ENTERPRISE_CONTENTS_ENDPOINT=

# ── Auth — currently disabled on all services ──────────────────────────────
AUTH_ENABLED=false
API_AUTH_TOKEN=REPLACE_WITH_SM_KEY_API_AUTH_TOKEN

# ── Analytics — currently 404-ing; kept non-blocking ───────────────────────
ANALYTICS_PIPELINE_ENABLED=false
ANALYTICS_ENDPOINT=
ANALYTICS_SERVICE_TOKEN=REPLACE_WITH_SM_KEY_ANALYTICS_SERVICE_TOKEN

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── AWS Secrets Manager (when set, settings.py injects SM values at boot) ───
AWS_REGION=
SM_SECRET_NAME=thinkvelocity/production/python-ai
