# =============================================================================
# enterprise-backend.env — NestJS Enterprise Backend
# DB: app_enterprise user, schema=enterprise in thinkvelocity_prod
# NOTE: Prisma requires ?schema=enterprise in DATABASE_URL
# =============================================================================

NODE_ENV=production
PORT=3000

# Database — Prisma connects with app_enterprise to enterprise schema
DATABASE_URL=postgresql://app_enterprise:REPLACE_WITH_SM_KEY_enterprise_db@127.0.0.1:5432/thinkvelocity_prod?schema=enterprise

# Redis
REDIS_URL=redis://:REPLACE_WITH_SM_KEY_redis@127.0.0.1:6379

# Auth — separate JWT secret from consumer (SOC2 CC6.2 — isolation)
JWT_SECRET=REPLACE_WITH_SM_KEY_enterprise_jwt_secret
JWT_EXPIRY=8h

# AI Models
GROQ_API_KEY=REPLACE_WITH_SM_KEY_groq_api_key
OPENAI_API_KEY=REPLACE_WITH_SM_KEY_openai_api_key

# Email
SENDGRID_API_KEY=REPLACE_WITH_SM_KEY_sendgrid_api_key

# CORS — enterprise domain only (SOC2 CC6.6)
ALLOWED_ORIGINS=https://enterprise.thinkvelocity.in

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# AWS
AWS_REGION=ap-south-1
SENTRY_DSN=REPLACE_WITH_SM_KEY_sentry_dsn
