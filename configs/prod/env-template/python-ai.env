# =============================================================================
# python-ai.env — Python AI Unified Service (FastAPI)
# Merges: python-backend-container + context-engine + prompt-enhance
# =============================================================================

APP_ENV=production
PORT=8005

# Database — uses app_consumer (same user as Node.js backend, consumer schema)
DATABASE_URL=postgresql://app_consumer:REPLACE_WITH_SM_KEY_consumer_db@127.0.0.1:5432/thinkvelocity_prod
DB_SCHEMA=consumer

# Redis
REDIS_URL=redis://:REPLACE_WITH_SM_KEY_redis@127.0.0.1:6379

# AI Models
GROQ_API_KEY=REPLACE_WITH_SM_KEY_groq_api_key
OPENAI_API_KEY=REPLACE_WITH_SM_KEY_openai_api_key
ANTHROPIC_API_KEY=REPLACE_WITH_SM_KEY_anthropic_api_key

# Embedding model for context engine
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# Context engine settings
MAX_CONTEXT_WINDOW=10
CONTEXT_SIMILARITY_THRESHOLD=0.75
MAX_MEMORIES_PER_USER=500

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_LLM_CALLS=10

# CORS
ALLOWED_ORIGINS=https://thinkvelocity.in,https://www.thinkvelocity.in,https://enterprise.thinkvelocity.in,chrome-extension://

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
SENTRY_DSN=REPLACE_WITH_SM_KEY_sentry_dsn

# AWS
AWS_REGION=ap-south-1
