# =============================================================================
# consumer-backend.env — Node.js Consumer Backend
# Deploy: Store in AWS Secrets Manager, inject at container start
# All REPLACE_WITH_SM_KEY_* values → fetch from SM at deploy time
# =============================================================================

NODE_ENV=production
PORT=3005

# Database — uses app_consumer with schema=consumer
DATABASE_URL=postgresql://app_consumer:REPLACE_WITH_SM_KEY_consumer_db@127.0.0.1:5432/thinkvelocity_prod
DB_SCHEMA=consumer

# Redis
REDIS_URL=redis://:REPLACE_WITH_SM_KEY_redis@127.0.0.1:6379

# Auth (SOC2 CC6.2)
JWT_SECRET=REPLACE_WITH_SM_KEY_jwt_secret
JWT_REFRESH_SECRET=REPLACE_WITH_SM_KEY_jwt_refresh_secret
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# AI Models
GROQ_API_KEY=REPLACE_WITH_SM_KEY_groq_api_key

# Payments (Razorpay)
RAZORPAY_KEY_ID=REPLACE_WITH_SM_KEY_razorpay_key_id
RAZORPAY_KEY_SECRET=REPLACE_WITH_SM_KEY_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_SM_KEY_razorpay_webhook_secret

# Email
SENDGRID_API_KEY=REPLACE_WITH_SM_KEY_sendgrid_api_key
EMAIL_FROM=noreply@thinkvelocity.in

# CORS (SOC2 CC6.6)
ALLOWED_ORIGINS=https://thinkvelocity.in,https://www.thinkvelocity.in

# Logging (SOC2 PI1.1)
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
SENTRY_DSN=REPLACE_WITH_SM_KEY_sentry_dsn

# S3 (for media uploads, evidence)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=thinkvelocity-backups

# Server
TRUST_PROXY=1
REQUEST_TIMEOUT_MS=60000
