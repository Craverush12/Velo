# =============================================================================
# extension-api.env — Extension FastAPI Service
# DB: app_extension user (reads shared + consumer, writes extension schema)
# =============================================================================

APP_ENV=production
PORT=8000

# Database
DATABASE_URL=postgresql://app_extension:REPLACE_WITH_SM_KEY_extension_db@127.0.0.1:5432/thinkvelocity_prod
DB_SCHEMA=extension

# Redis
REDIS_URL=redis://:REPLACE_WITH_SM_KEY_redis@127.0.0.1:6379

# Auth — same JWT secret as consumer backend (extension authenticates same users)
JWT_SECRET=REPLACE_WITH_SM_KEY_jwt_secret

# AI
GROQ_API_KEY=REPLACE_WITH_SM_KEY_groq_api_key

# CORS — allow Chrome extension + consumer site
ALLOWED_ORIGINS=https://thinkvelocity.in,https://www.thinkvelocity.in,chrome-extension://

# Rate limiting (SOC2 CC6.1)
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=5

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# AWS
AWS_REGION=ap-south-1
